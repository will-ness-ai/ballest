{
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-list *)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm vitest run)",
      "Bash(pnpm vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(python tools/check_data.py)",
      "Bash(python tools/check_data.py *)",
      "Bash(pnpm shot *)",
      "Bash(node --check *)",
      "Bash(python -m py_compile *)",
      "Bash(curl -s https://ballestrecords.com/*)",
      "Bash(curl -sI https://ballestrecords.com/*)",
      "Bash(curl -s https://ballest.willness.dev/*)",
      "Bash(curl -sI https://ballest.willness.dev/*)",
      "Bash(~/.fly/bin/flyctl.exe status *)",
      "Bash(~/.fly/bin/flyctl.exe logs *)",
      "Bash(nslookup *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
