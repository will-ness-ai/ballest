{
  "name": "ballest-web",
  "private": true,
  "description": "The site on Next.js for Vercel; see docs/adr/0004 and docs/nextjs-migration.md",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-site.mjs",
    "dev": "node scripts/sync-site.mjs && next dev",
    "dev:up": "scripts/dev-up.sh",
    "dev:down": "scripts/free-port.sh",
    "build": "node scripts/sync-site.mjs && node scripts/migrate.mjs && next build",
    "start": "next start",
    "serve": "scripts/serve.sh",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "qa": "node scripts/qa.mjs",
    "gen": "tsx scripts/gen.ts",
    "campaign": "tsx scripts/campaign.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "qrcode-generator": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
