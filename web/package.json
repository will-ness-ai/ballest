{
  "name": "ballest-web",
  "private": true,
  "description": "The site on Next.js for Vercel; see docs/adr/0004 and docs/nextjs-migration.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-site.mjs",
    "dev": "node scripts/sync-site.mjs && next dev",
    "build": "node scripts/sync-site.mjs && node scripts/migrate.mjs && next build",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:parity": "tsx scripts/parity.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
