{
  "name": "multiballs",
  "private": true,
  "description": "Multiballs: an unofficial community Discord bot for timed Ballest Matches",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
