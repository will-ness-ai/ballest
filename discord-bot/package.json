  "dependencies": {
    "@effect/platform": "0.97.2",
    "@effect/platform-node": "0.108.2",
    "@effect/sql": "0.52.1",
    "@effect/sql-sqlite-node": "0.53.0",
    "discord.js": "14.27.0",
    "effect": "3.22.2",
    "steam-user": "5.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@types/node": "^22.20.4",
    "@types/steam-user": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "~3.2.7"
  }
