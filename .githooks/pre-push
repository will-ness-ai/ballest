#!/bin/sh
# Before a push, the format and lint checks CI runs (`pnpm check`, docs/linting.md), so a push
# never turns CI red on a lint error, and a refusal to stack commits on an already-merged PR
# (merged-pr.mjs). Turned on by `pnpm install` at the root (its prepare script).
node "$(dirname "$0")/merged-pr.mjs" || exit 1
exec pnpm --silent check
