# secrets
.env
tools/refresh_token.txt
# dated backups of the two above (.env.<stamp>.bak, refresh_token.txt.<account>.unusable)
*.bak
*.unusable

# crash dumps Git Bash's tools leave in the working directory
*.stackdump

# local editor / Claude Code settings
.claude/settings.local.json
.claude/worktrees/

# steamworks runtime files (copied in / generated)
tools/steam_api64.dll
tools/steam_appid.txt

# local python env for the steam.py collector (bundled 3.11 + venv)
tools/pythons/
tools/.venv-steampy/

# private reverse-engineering notes + capture tooling: these reference the
# game's internal backend (hostnames/endpoints). Kept local, never published.
research/
capture/
tools/start-capture.ps1
tools/stop-capture.ps1

# local scratch. scratch/ is served by the dev server like any other folder, so
# a prototype page can be opened at /scratch/<name>.html without landing in a commit.
scratch/
__pycache__/
.pytest_cache/
node_modules/
*.pyc

# data/: no longer committed. The collector writes only the database since phase 5 of
# docs/nextjs-migration.md, and its JSON stays in git history (tools/db_backfill.py); a
# local data/ is the legacy SDK collector's (campaign.json).
data/
