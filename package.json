{
  "name": "ballest-lint",
  "private": true,
  "description": "Formatting and linting for the whole repo; see docs/linting.md",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write . && ruff format",
    "format:check": "node web/scripts/check-ruff.mjs && prettier --check . && ruff format --check",
    "lint": "eslint --max-warnings=0 . && ruff check && node web/scripts/check-styles.mjs",
    "lint:fix": "eslint --fix . && ruff check --fix",
    "check": "pnpm format:check && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
